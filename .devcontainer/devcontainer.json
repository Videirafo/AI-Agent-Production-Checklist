{
  "name": "Safe Agent API",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "cd examples/safe-agent-api && pip install -e '.[dev]'",
  "postStartCommand": "cd examples/safe-agent-api && nohup fastapi dev app/main.py --host 0.0.0.0 --port 8000 > /tmp/safe-agent-api.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Safe Agent Playground",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
